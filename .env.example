# FG To-Do-Manager – configuration
# Copy this file to `.env` and adjust the values.

# --- Server ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Public address of the application (used in e-mail links). Use https:// in production –
# session cookies are then marked "Secure" automatically.
BASE_URL=http://localhost:3000
# Set to true when running behind a reverse proxy (nginx, Caddy, ...)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database: sqlite | pg ---
DB_CLIENT=sqlite
SQLITE_FILE=./data/todo-manager.db
# Required for DB_CLIENT=pg
# DATABASE_URL=postgres://user:password@localhost:5432/todo_manager

# Session lifetime in hours (default 14 days)
SESSION_TTL_HOURS=336
# Max. login / password reset / invitation requests per minute and IP address
AUTH_RATE_LIMIT=10

# --- E-mail: smtp | log ---
# "log" only writes mails to the server log (for testing).
MAIL_TRANSPORT=log
MAIL_FROM=FG To-Do-Manager <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Default language for new accounts: de | en
DEFAULT_LOCALE=de
# Time zone for due dates and reminders
APP_TIMEZONE=Europe/Berlin
# How often due-date reminders are checked (minutes); 0 disables them
REMINDER_INTERVAL_MINUTES=60
# Maximum size of a tenant import file (MB)
IMPORT_MAX_MB=50
